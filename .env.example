# Скопируй в .env и заполни своими значениями.
# .env в git не попадает — ключи не коммитить и не публиковать.

# ElevenLabs: генерация голосов, рычания и звуковых реплик.
# Ключ: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Голос по умолчанию (ID из аккаунта или библиотеки). Необязателен.
ELEVENLABS_VOICE_ID=

# Модель синтеза: eleven_v4 (по умолчанию), eleven_v4_turbo, eleven_multilingual_v2.
ELEVENLABS_MODEL_ID=eleven_v4
